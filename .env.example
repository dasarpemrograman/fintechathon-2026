# Copy to .env for optional live-provider configuration:
#   cp .env.example .env
# The offline seeded demo needs no provider keys.
# Exported environment variables override .env; generated local DB settings
# remain in .local/runtime.env. Never commit your populated .env.

# Licensed public search (Brave).
BRAVE_SEARCH_API_KEY=

# OpenAI-compatible LLM. Use the API base URL ending in /v1, NOT the full
# /chat/completions URL: the adapter appends /chat/completions itself.
FINCATHON_MODEL_BASE_URL=https://api.openai.com/v1
FINCATHON_MODEL_ID=
FINCATHON_MODEL_API_KEY=

# Optional Google Calendar OAuth. Register the exact redirect URI for your
# acceptance client. Credentials alone do not establish live acceptance.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth/calendar/callback

# OAuth connection and calendar selection do not enable event writes.
# For regular use, enable only after real lifecycle acceptance, with a reference
# to retained receipts. An isolated acceptance instance may use a test-run
# reference for its approved test account; this is not a release acceptance.
# API admission, worker and outbox all enforce this gate. Demo cannot write live.
FINCATHON_CALENDAR_LIVE_ENABLED=false
FINCATHON_CALENDAR_ACCEPTANCE_REFERENCE=

# Optional host API/worker overrides; leave commented for the documented setup.
# scripts/dev.py selects normal/demo mode through its --demo flag.
# APP_MODE=normal
# DATABASE_URL=postgresql+psycopg://fincathon:YOUR_LOCAL_PASSWORD@127.0.0.1:15432/fincathon
# STORAGE_PATH=/absolute/path/to/private/files
# FINCATHON_TESSDATA_PATH=/absolute/path/to/verified/tessdata

# Frankfurter reference FX needs no API key, but requires network access.
